<Window x:Class="DevBreak.TopicsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dev break - topics"
        Icon="pack://application:,,,/Assets/DevBreak.ico"
        Width="760" Height="720" MinWidth="560" MinHeight="500"
        Background="{StaticResource PaperGridBrush}"
        FontFamily="{StaticResource BodyFont}" FontSize="14" Foreground="{StaticResource InkBrush}"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="36,26,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Image Source="{StaticResource LogoImage}" Width="36" Height="36" Margin="0,0,12,0" />
                <TextBlock x:Name="Greeting" Style="{StaticResource HandNote}" FontSize="24" />
            </StackPanel>
            <!-- "learn" gets a highlighter stroke across its lower half -->
            <WrapPanel>
                <TextBlock Text="What do you want to " Style="{StaticResource Heading}" FontSize="36" />
                <Grid>
                    <Border Background="{StaticResource MarkerBrush}" Height="20" VerticalAlignment="Bottom" Margin="-4,0,-4,6" />
                    <TextBlock Text="learn" Style="{StaticResource Heading}" FontSize="36" />
                </Grid>
                <TextBlock Text="?" Style="{StaticResource Heading}" FontSize="36" />
            </WrapPanel>
            <TextBlock x:Name="IntroText" Style="{StaticResource Caption}" FontSize="14.5" Margin="0,6,0,0" />
        </StackPanel>

        <!-- the topics to pick from -->
        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0">
                <UniformGrid x:Name="TopicList" Columns="2" VerticalAlignment="Top" Margin="0,0,0,4" />
            </ScrollViewer>
            <StackPanel x:Name="Loading" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220" Margin="0,0,0,10" />
                <TextBlock x:Name="LoadingText" HorizontalAlignment="Center" Style="{StaticResource Caption}" />
            </StackPanel>
            <TextBlock x:Name="EmptyText" Style="{StaticResource Caption}" FontSize="14" Margin="16"
                       VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed" />
        </Grid>

        <!-- add your own, shaped by Claude -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Rectangle RadiusX="16" RadiusY="16" Fill="{StaticResource CardBrush}" Stroke="{StaticResource MutedBrush}"
                       StrokeThickness="1.5" StrokeDashArray="4 3" />
            <StackPanel Margin="18,14,18,14">
                <TextBlock x:Name="AddLabel" Text="Add a topic of your own" FontWeight="Bold" FontSize="15" Margin="0,0,0,8" />
                <DockPanel>
                    <Button x:Name="AddButton" DockPanel.Dock="Right" Style="{StaticResource MarkerButton}" Margin="10,0,0,0"
                            IsEnabled="False" AutomationProperties.Name="Add with AI" Click="Add_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource SparkleIcon}" Style="{StaticResource IconPath}" Margin="0,0,8,0" />
                            <TextBlock Text="Add with AI" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Grid>
                        <TextBox x:Name="WishBox" Style="{StaticResource NotebookBox}" Padding="12,0" VerticalContentAlignment="Center"
                                 Height="44" AutomationProperties.LabeledBy="{Binding ElementName=AddLabel}"
                                 TextChanged="WishBox_TextChanged" KeyDown="WishBox_KeyDown" />
                        <TextBlock x:Name="WishPlaceholder" Text="I want to learn business regulation on PII"
                                   Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="16,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </DockPanel>
                <TextBlock x:Name="AddHint" Text="Claude turns it into a topic with sub-topics."
                           Style="{StaticResource Caption}" Margin="2,8,0,0" />
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,18,0,0">
            <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Save" Style="{StaticResource PrimaryButton}" Padding="30,0"
                    Click="Save_Click" />
            <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" IsCancel="True" />
            <TextBlock x:Name="CountText" Style="{StaticResource HandNote}" FontSize="24" Foreground="{StaticResource InkSoftBrush}" />
        </DockPanel>
    </Grid>
</Window>
