<Window x:Class="DevBreak.TopicsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dev break - topics"
        Width="720" Height="680" MinWidth="520" MinHeight="460"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20,14,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="What do you want to learn?" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="IntroText" TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0" />
        </StackPanel>

        <!-- the topics to pick from -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="TopicList" Margin="6" />
                </ScrollViewer>
                <StackPanel x:Name="Loading" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="220" Margin="0,0,0,10" />
                    <TextBlock x:Name="LoadingText" HorizontalAlignment="Center" Opacity="0.7" />
                </StackPanel>
                <TextBlock x:Name="EmptyText" TextWrapping="Wrap" Opacity="0.75" Margin="16"
                           VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- add your own, shaped by Claude -->
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="Add a topic of your own" FontWeight="SemiBold" Margin="0,0,0,4" />
            <DockPanel>
                <Button x:Name="AddButton" DockPanel.Dock="Right" Content="Add with AI" Padding="14,5" Margin="8,0,0,0"
                        IsEnabled="False" Click="Add_Click" />
                <TextBox x:Name="WishBox" TextChanged="WishBox_TextChanged" KeyDown="WishBox_KeyDown" />
            </DockPanel>
            <TextBlock x:Name="AddHint" Text="e.g. &quot;I want to learn business regulation on PII&quot; - Claude turns it into a topic"
                       Opacity="0.55" FontSize="11" Margin="2,3,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Padding="14,6" Margin="0,0,8,0" IsCancel="True" />
            <Button x:Name="SaveButton" Content="Save" Padding="18,6" Style="{DynamicResource AccentButtonStyle}"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
