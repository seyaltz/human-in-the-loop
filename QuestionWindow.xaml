<Window x:Class="DevBreak.QuestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DevBreak"
        Title="Dev break"
        Icon="pack://application:,,,/Assets/DevBreak.ico"
        Width="900" Height="680" MinWidth="680" MinHeight="480"
        Background="{StaticResource PaperGridBrush}"
        FontFamily="{StaticResource BodyFont}" FontSize="14" Foreground="{StaticResource InkBrush}"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- top bar: logo and modes on the left, the game on the right -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="{StaticResource LogoImage}" Width="34" Height="34" Margin="0,0,14,0" />
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource InkBrush}" BorderThickness="1.5"
                        CornerRadius="22" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="QuizMode" Content="Quiz" GroupName="Mode" IsChecked="True"
                                     Style="{StaticResource ModeTab}" Checked="Mode_Checked" />
                        <RadioButton x:Name="LearnMode" Content="Learn" GroupName="Mode" Margin="4,0,0,0"
                                     Style="{StaticResource ModeTab}" Checked="Mode_Checked" />
                        <RadioButton x:Name="StatsMode" Content="Stats" GroupName="Mode" Margin="4,0,0,0"
                                     Style="{StaticResource ModeTab}" Checked="Mode_Checked" />
                        <RadioButton x:Name="TldrMode" Content="TL;DR" GroupName="Mode" Margin="4,0,0,0"
                                     Style="{StaticResource ModeTab}" Checked="Mode_Checked" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Button x:Name="SettingsButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="8,0,0,0"
                    ToolTip="Settings" AutomationProperties.Name="Settings" Click="Settings_Click">
                <Path Data="{StaticResource SettingsIcon}" Style="{StaticResource IconPath}" Width="20" Height="20" />
            </Button>

            <!-- rank + XP, streak, today's goal -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border x:Name="XpChip" Style="{StaticResource HudChip}" Background="{StaticResource MarkerBrush}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource BoltIcon}" Fill="{StaticResource InkBrush}" Stretch="Uniform"
                              Width="14" Height="14" Margin="0,0,6,0" />
                        <TextBlock x:Name="XpText" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border x:Name="StreakChip" Style="{StaticResource HudChip}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource FlameIcon}" Fill="{StaticResource CoralBrush}" Stroke="{StaticResource InkBrush}"
                              StrokeThickness="1.5" Stretch="Uniform" Width="16" Height="18" Margin="0,0,6,0" />
                        <TextBlock x:Name="StreakText" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border x:Name="GoalChip" Style="{StaticResource HudChip}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource TargetIcon}" Stroke="{StaticResource VioletBrush}" StrokeThickness="2"
                              Stretch="Uniform" Width="15" Height="15" Margin="0,0,6,0" />
                        <TextBlock x:Name="GoalText" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <local:LearnView x:Name="LearnView" Grid.Row="1" Visibility="Collapsed" />
        <local:StatsView x:Name="StatsView" Grid.Row="1" Visibility="Collapsed" />
        <local:TldrView x:Name="TldrView" Grid.Row="1" Visibility="Collapsed" />

        <!-- quiz -->
        <Grid x:Name="QuizView" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="AnswerRow" Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                <TextBlock x:Name="LevelNote" DockPanel.Dock="Right" Style="{StaticResource HandNote}"
                           VerticalAlignment="Top" Margin="12,0,0,0" />
                <ListBox x:Name="Topics" Style="{StaticResource ChipList}" SelectionChanged="Topics_SelectionChanged" />
            </DockPanel>

            <!-- the question card: a page with a margin line -->
            <ContentControl Grid.Row="1" Style="{StaticResource ShadowCard}" Padding="0">
                <Grid>
                    <Rectangle Width="2" HorizontalAlignment="Left" Margin="30,0,0,0" Fill="{StaticResource CoralBrush}" Opacity="0.55" />
                    <DockPanel Margin="48,16,20,12">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Border x:Name="LevelBadge" CornerRadius="9" Padding="9,2" VerticalAlignment="Center"
                                    BorderBrush="{StaticResource InkBrush}" BorderThickness="1.2">
                                <TextBlock x:Name="LevelText" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                            </Border>
                            <TextBlock x:Name="TopicText" Style="{StaticResource Heading}" FontSize="19" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid>
                            <RichTextBox x:Name="QuestionBox" Style="{StaticResource ReadingBox}" FontSize="16" />
                            <StackPanel x:Name="Loading" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="220" Margin="0,0,0,10" />
                                <TextBlock x:Name="LoadingText" HorizontalAlignment="Center" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Grid>
            </ContentControl>

            <!-- hint + your answer -->
            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                <Expander x:Name="TheoryExpander" Header="Hint: background theory" Style="{StaticResource NoteExpander}"
                          Margin="0,0,0,12" Expanded="Theory_Toggled" Collapsed="Theory_Toggled">
                    <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="14,10">
                        <RichTextBox x:Name="TheoryBox" Style="{StaticResource ReadingBox}" MaxHeight="200" FontSize="14" />
                    </Border>
                </Expander>
                <TextBlock x:Name="MineLabel" Text="Your answer" FontWeight="Bold" FontSize="15" Margin="2,0,0,6" />
                <Grid>
                    <TextBox x:Name="MineBox" Style="{StaticResource NotebookBox}" Height="84" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             AutomationProperties.Name="Your answer"
                             TextChanged="MineBox_TextChanged" />
                    <TextBlock x:Name="MinePlaceholder" Text="Explain it in your own words, like to a teammate..."
                               Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="16,11,0,0"
                               IsHitTestVisible="False" />
                </Grid>
                <TextBlock x:Name="MineHint" Style="{StaticResource Caption}" Margin="2,6,0,0">
                    Up to <Run Text="110 XP" FontWeight="Bold" Foreground="{StaticResource InkBrush}" /> for a full answer. Just peeking at the answer gives 5 XP.
                </TextBlock>
            </StackPanel>

            <!-- answer, hidden until asked -->
            <DockPanel Grid.Row="3" x:Name="AnswerPanel" Margin="0,14,0,0" Visibility="Collapsed">
                <!-- the score: the teacher's stamp, and what to add -->
                <Border x:Name="FeedbackCard" DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12"
                        Padding="16,12" Visibility="Collapsed">
                    <DockPanel>
                        <Border x:Name="ScoreBadge" DockPanel.Dock="Right" Width="96" Height="96" CornerRadius="48"
                                BorderBrush="{StaticResource CoralBrush}" BorderThickness="3" Margin="16,0,4,0"
                                VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                            <Border.RenderTransform>
                                <RotateTransform Angle="-10" />
                            </Border.RenderTransform>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ScoreText" FontFamily="{StaticResource HandFont}" FontWeight="Bold" FontSize="38"
                                           Foreground="{StaticResource CoralInkBrush}" HorizontalAlignment="Center"
                                           Margin="0,-6,0,-8" />
                                <TextBlock x:Name="ScoreWord" FontFamily="{StaticResource HandFont}" FontWeight="Bold" FontSize="18"
                                           Foreground="{StaticResource CoralInkBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="FeedbackText" TextWrapping="Wrap" FontSize="14.5" LineHeight="22"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                    <Button x:Name="DiscussButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Height="38"
                            Padding="14,0" AutomationProperties.Name="Discuss with Claude" Click="Discuss_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource ChatIcon}" Style="{StaticResource IconPath}" StrokeThickness="1.8"
                                  Margin="0,0,8,0" />
                            <TextBlock Text="Discuss with Claude" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Model answer" Style="{StaticResource Heading}" FontSize="17" VerticalAlignment="Center" />
                        <ProgressBar x:Name="ScoringBar" IsIndeterminate="True" Width="80" Margin="12,0,8,0"
                                     VerticalAlignment="Center" Visibility="Collapsed" />
                        <TextBlock x:Name="ScoringText" Text="Scoring your answer..." Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Visibility="Collapsed" />
                    </StackPanel>
                </DockPanel>
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <RichTextBox x:Name="AnswerBox" Style="{StaticResource ReadingBox}" FontSize="14.5" />
                </Border>
            </DockPanel>

            <!-- actions: just three -->
            <DockPanel Grid.Row="4" Margin="0,16,0,0" LastChildFill="False">
                <Button x:Name="ShowButton" DockPanel.Dock="Left" Content="Show answer" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0" IsEnabled="False" Click="Show_Click" />
                <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Next question"
                        Click="Next_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Next" VerticalAlignment="Center" />
                        <Path Data="{StaticResource ArrowIcon}" Style="{StaticResource IconPath}" Width="16" Height="16"
                              Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="CheckButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" IsEnabled="False"
                        AutomationProperties.Name="Check my answer"
                        Click="Check_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource CheckIcon}" Style="{StaticResource IconPath}" Stroke="White"
                              StrokeThickness="2.6" Margin="0,0,8,0" />
                        <TextBlock Text="Check my answer" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Grid>

        <!-- celebration toast: +XP, badges, rank up -->
        <Border x:Name="Toast" Grid.RowSpan="2" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,58,0,0"
                CornerRadius="14" Padding="20,12" Background="{StaticResource InkBrush}"
                BorderBrush="{StaticResource MarkerBrush}" BorderThickness="2"
                IsHitTestVisible="False" Opacity="0" Visibility="Collapsed">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="15" FontWeight="Bold" TextAlignment="Center" />
        </Border>
    </Grid>
</Window>
