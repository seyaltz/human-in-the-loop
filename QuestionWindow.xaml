<Window x:Class="DevBreak.QuestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DevBreak"
        Title="Dev break"
        Width="900" Height="680" MinWidth="560" MinHeight="460"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Grid Margin="20,12,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- one window, two modes: the quiz and the learn path -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <RadioButton x:Name="QuizMode" Content="Quiz" GroupName="Mode" IsChecked="True" Padding="18,6"
                         Style="{StaticResource {x:Type ToggleButton}}" Checked="Mode_Checked" />
            <RadioButton x:Name="LearnMode" Content="Learn path" GroupName="Mode" Padding="18,6" Margin="6,0,0,0"
                         Style="{StaticResource {x:Type ToggleButton}}" Checked="Mode_Checked" />
        </StackPanel>

        <local:LearnView x:Name="LearnView" Grid.Row="1" Visibility="Collapsed" />

    <Grid x:Name="QuizView" Grid.Row="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="AnswerRow" Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- topic tabs: headers only, the question area below is shared -->
        <TabControl x:Name="Tabs" Grid.Row="0" SelectionChanged="Tabs_SelectionChanged" Margin="0,0,0,10" />

        <!-- header: level badge + topic -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Knowledge about me" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="KnowledgeChoice" Width="200" Margin="0,0,16,0" />
                <TextBlock Text="Level for new questions" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="LevelChoice" Width="190" SelectedIndex="0" />
            </StackPanel>
            <Border x:Name="LevelBadge" CornerRadius="10" Padding="10,2" VerticalAlignment="Center">
                <TextBlock x:Name="LevelText" Foreground="White" FontWeight="SemiBold" FontSize="12" />
            </Border>
            <TextBlock x:Name="TopicText" Margin="10,0,0,0" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <!-- question -->
        <Grid Grid.Row="2">
            <RichTextBox x:Name="QuestionBox" IsReadOnly="True" IsDocumentEnabled="True"
                         VerticalScrollBarVisibility="Auto" FontSize="14" Padding="10"
                         VerticalContentAlignment="Top" />
            <StackPanel x:Name="Loading" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220" Margin="0,0,0,10" />
                <TextBlock x:Name="LoadingText" HorizontalAlignment="Center" Opacity="0.7" />
            </StackPanel>
        </Grid>

        <!-- your answer, with the background theory as an open/close hint above it -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <Expander x:Name="TheoryExpander" Header="Hint: background theory" Margin="0,0,0,10"
                      Expanded="Theory_Toggled" Collapsed="Theory_Toggled">
                <RichTextBox x:Name="TheoryBox" IsReadOnly="True" IsDocumentEnabled="True" MaxHeight="200"
                             VerticalScrollBarVisibility="Auto" FontSize="13.5" Padding="10" Margin="0,6,0,0" />
            </Expander>
            <TextBlock Text="Your answer (optional)" Opacity="0.7" Margin="0,0,0,4" />
            <TextBox x:Name="MineBox" Height="64" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                     TextChanged="MineBox_TextChanged" />
        </StackPanel>

        <!-- answer, hidden until asked -->
        <DockPanel Grid.Row="4" x:Name="AnswerPanel" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Answer" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border x:Name="ScoreBadge" CornerRadius="10" Padding="10,2" Margin="10,0,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ScoreText" Foreground="White" FontWeight="SemiBold" />
                </Border>
                <ProgressBar x:Name="ScoringBar" IsIndeterminate="True" Width="80" Margin="10,0,6,0"
                             VerticalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="ScoringText" Text="Scoring your answer..." Opacity="0.7"
                           VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" x:Name="FeedbackText" TextWrapping="Wrap" Margin="0,2,0,8"
                       Visibility="Collapsed" />
            <RichTextBox x:Name="AnswerBox" IsReadOnly="True" IsDocumentEnabled="True"
                         VerticalScrollBarVisibility="Auto" FontSize="13.5" Padding="10" />
        </DockPanel>

        <!-- actions -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="DiscussButton" Content="Discuss" Margin="0,0,8,0" Padding="14,6" IsEnabled="False"
                    Click="Discuss_Click" />
            <Button Content="Next question" Margin="0,0,8,0" Padding="14,6" Click="Next_Click" />
            <Button x:Name="SnoozeButton" Margin="0,0,8,0" Padding="14,6" Click="Snooze_Click" />
            <Button Content="Skip" Margin="0,0,8,0" Padding="14,6" Click="Skip_Click" />
            <Button x:Name="ShowButton" Content="Show answer" Margin="0,0,8,0" Padding="14,6" IsEnabled="False"
                    Click="Show_Click" />
            <Button x:Name="CheckButton" Content="Check my answer" Padding="14,6" IsEnabled="False"
                    Style="{DynamicResource AccentButtonStyle}" Click="Check_Click" />
        </StackPanel>
    </Grid>
    </Grid>
</Window>
