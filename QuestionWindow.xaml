<Window x:Class="DevBreak.QuestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DevBreak"
        Title="Dev break"
        Width="900" Height="680" MinWidth="640" MinHeight="460"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Grid Margin="20,12,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- top bar: modes on the left, the game on the right -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="QuizMode" Content="Quiz" GroupName="Mode" IsChecked="True" Padding="16,5"
                             Style="{StaticResource {x:Type ToggleButton}}" Checked="Mode_Checked" />
                <RadioButton x:Name="LearnMode" Content="Learn" GroupName="Mode" Padding="16,5" Margin="4,0,0,0"
                             Style="{StaticResource {x:Type ToggleButton}}" Checked="Mode_Checked" />
                <RadioButton x:Name="StatsMode" Content="Stats" GroupName="Mode" Padding="16,5" Margin="4,0,0,0"
                             Style="{StaticResource {x:Type ToggleButton}}" Checked="Mode_Checked" />
            </StackPanel>

            <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="&#x2699;" FontSize="16" Padding="10,2"
                    Margin="12,0,0,0" ToolTip="Settings" Click="Settings_Click" />

            <!-- rank + XP, streak, today's goal -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border x:Name="RankBadge" CornerRadius="10" Padding="10,2" VerticalAlignment="Center">
                    <TextBlock x:Name="RankText" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                </Border>
                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center" Width="130">
                    <ProgressBar x:Name="XpBar" Height="6" Maximum="1" />
                    <TextBlock x:Name="XpText" FontSize="11" Opacity="0.7" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock x:Name="StreakText" FontSize="14" FontWeight="SemiBold" Margin="16,0,0,0"
                           VerticalAlignment="Center" ToolTip="Daily streak" />
                <TextBlock x:Name="GoalText" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <local:LearnView x:Name="LearnView" Grid.Row="1" Visibility="Collapsed" />
        <local:StatsView x:Name="StatsView" Grid.Row="1" Visibility="Collapsed" />

        <!-- quiz -->
        <Grid x:Name="QuizView" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="AnswerRow" Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListBox x:Name="Topics" Grid.Row="0" Style="{StaticResource ChipList}" Margin="0,0,0,6"
                     SelectionChanged="Topics_SelectionChanged" />

            <!-- the question card -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,8,10,0">
                        <Border x:Name="LevelBadge" CornerRadius="10" Padding="10,2" VerticalAlignment="Center">
                            <TextBlock x:Name="LevelText" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                        <TextBlock x:Name="TopicText" Margin="10,0,0,0" FontSize="17" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid>
                        <RichTextBox x:Name="QuestionBox" IsReadOnly="True" IsDocumentEnabled="True" BorderThickness="0"
                                     Background="Transparent" VerticalScrollBarVisibility="Auto" FontSize="14"
                                     Padding="6" VerticalContentAlignment="Top" />
                        <StackPanel x:Name="Loading" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="220" Margin="0,0,0,10" />
                            <TextBlock x:Name="LoadingText" HorizontalAlignment="Center" Opacity="0.7" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- hint + your answer -->
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <Expander x:Name="TheoryExpander" Header="Hint: background theory" Margin="0,0,0,8"
                          Expanded="Theory_Toggled" Collapsed="Theory_Toggled">
                    <RichTextBox x:Name="TheoryBox" IsReadOnly="True" IsDocumentEnabled="True" MaxHeight="200"
                                 VerticalScrollBarVisibility="Auto" FontSize="13.5" Padding="10" Margin="0,6,0,0" />
                </Expander>
                <TextBox x:Name="MineBox" Height="64" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         TextChanged="MineBox_TextChanged" />
                <TextBlock x:Name="MineHint" Text="Type your answer to earn up to 110 XP, or just show the answer (5 XP)"
                           Opacity="0.55" FontSize="11" Margin="2,3,0,0" />
            </StackPanel>

            <!-- answer, hidden until asked -->
            <DockPanel Grid.Row="3" x:Name="AnswerPanel" Margin="0,10,0,0" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button x:Name="DiscussButton" DockPanel.Dock="Right" Content="&#x1F4AC; Discuss" Padding="12,3"
                            Click="Discuss_Click" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Answer" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border x:Name="ScoreBadge" CornerRadius="10" Padding="10,2" Margin="10,0,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="ScoreText" Foreground="White" FontWeight="SemiBold" />
                        </Border>
                        <ProgressBar x:Name="ScoringBar" IsIndeterminate="True" Width="80" Margin="10,0,6,0"
                                     VerticalAlignment="Center" Visibility="Collapsed" />
                        <TextBlock x:Name="ScoringText" Text="Scoring your answer..." Opacity="0.7"
                                   VerticalAlignment="Center" Visibility="Collapsed" />
                    </StackPanel>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="FeedbackText" TextWrapping="Wrap" Margin="0,2,0,8"
                           Visibility="Collapsed" />
                <RichTextBox x:Name="AnswerBox" IsReadOnly="True" IsDocumentEnabled="True"
                             VerticalScrollBarVisibility="Auto" FontSize="13.5" Padding="10" />
            </DockPanel>

            <!-- actions: just three -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="ShowButton" Content="Show answer" Margin="0,0,8,0" Padding="14,6" IsEnabled="False"
                        Click="Show_Click" />
                <Button Content="Next &#x25B6;" Margin="0,0,8,0" Padding="14,6" Click="Next_Click" />
                <Button x:Name="CheckButton" Content="Check &#x2713;" Padding="18,6" IsEnabled="False"
                        Style="{DynamicResource AccentButtonStyle}" Click="Check_Click" />
            </StackPanel>
        </Grid>

        <!-- celebration toast: +XP, badges, rank up -->
        <Border x:Name="Toast" Grid.RowSpan="2" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,46,0,0"
                CornerRadius="12" Padding="18,10" Background="#E6202020" IsHitTestVisible="False" Opacity="0"
                Visibility="Collapsed">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" />
        </Border>
    </Grid>
</Window>
