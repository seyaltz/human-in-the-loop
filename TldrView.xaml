<UserControl x:Class="DevBreak.TldrView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- one TL;DR per topic, as chips -->
        <ListBox x:Name="Tabs" Grid.Row="0" Style="{StaticResource ChipList}" Margin="0,0,0,8"
                 SelectionChanged="Tabs_SelectionChanged" />

        <!-- what it is, how fresh, and what to do with it -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,12,16,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Content="Refresh" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                            Click="Refresh_Click" />
                    <Button x:Name="DiscussButton" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Discuss"
                            Click="Discuss_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource ChatIcon}" Style="{StaticResource IconPath}" Stroke="White"
                                  Width="16" Height="16" Margin="0,0,8,0" />
                            <TextBlock Text="Discuss" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="fresh from the web" Style="{StaticResource HandNote}" FontSize="19" />
                    <TextBlock x:Name="TldrTitle" Style="{StaticResource Heading}" FontSize="24" Margin="0,2,0,2" />
                    <TextBlock x:Name="WrittenText" Style="{StaticResource Eyebrow}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- the sections as sub-tabs, in the same style as the mode tabs -->
        <Border Grid.Row="2" HorizontalAlignment="Left" Margin="0,0,0,12" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource InkBrush}" BorderThickness="1.5" CornerRadius="22" Padding="4">
            <StackPanel x:Name="SectionTabs" Orientation="Horizontal" />
        </Border>

        <!-- the open section -->
        <ContentControl Grid.Row="3" Style="{StaticResource ShadowCard}" Padding="22,16,12,14">
            <Grid>
                <RichTextBox x:Name="TldrBox" Style="{StaticResource ReadingBox}" FontSize="14.5" />
                <StackPanel x:Name="Loading" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="220" Margin="0,0,0,10" />
                    <TextBlock x:Name="LoadingText" HorizontalAlignment="Center" Style="{StaticResource Caption}" />
                </StackPanel>
            </Grid>
        </ContentControl>
    </Grid>
</UserControl>
