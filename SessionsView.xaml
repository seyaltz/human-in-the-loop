<UserControl x:Class="DevBreak.SessionsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DevBreak"
        >
    <UserControl.Resources>
        <!-- a pill like the mode tabs, dark when on -->
        <Style x:Key="PillToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border CornerRadius="16" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                BorderBrush="{StaticResource InkBrush}" BorderThickness="1.5">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource VioletTintBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource InkBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- the sessions: a new one in a folder, or one to continue -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,4" Padding="14,14,8,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="2,0,6,10">
                    <TextBlock Text="your Claude Code, here" Style="{StaticResource HandNote}" FontSize="19" />
                    <DockPanel Margin="0,2,0,10">
                        <ToggleButton x:Name="SplitButton" DockPanel.Dock="Right" Content="Split" Style="{StaticResource PillToggle}"
                                      ToolTip="Two sessions side by side" Checked="Split_Changed" Unchecked="Split_Changed" />
                        <ToggleButton x:Name="GroupButton" DockPanel.Dock="Right" Content="By folder" Style="{StaticResource PillToggle}"
                                      Margin="0,0,6,0" Padding="11,0" ToolTip="Group the sessions by their folder"
                                      Checked="Group_Changed" Unchecked="Group_Changed" />
                        <TextBlock Text="Sessions" Style="{StaticResource Heading}" FontSize="22" />
                    </DockPanel>
                    <DockPanel>
                        <Button x:Name="RefreshListButton" DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" Click="RefreshList_Click" />
                        <Button x:Name="NewButton" Content="New session..." Style="{StaticResource PrimaryButton}"
                                Padding="14,0" Click="New_Click" ToolTip="Pick a folder and start a Claude Code session in it" />
                    </DockPanel>
                </StackPanel>
                <ListBox x:Name="SessionList" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SessionList_SelectionChanged"
                         AutomationProperties.Name="Sessions" />
            </DockPanel>
        </Border>

        <!-- one pane, or two side by side -->
        <Grid x:Name="Panes" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SecondColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <local:SessionPane x:Name="PaneA" Grid.Column="0" />
            <local:SessionPane x:Name="PaneB" Grid.Column="1" Margin="14,0,0,0" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
