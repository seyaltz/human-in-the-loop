<UserControl x:Class="DevBreak.SessionsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DevBreak"
        >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- the sessions: a new one in a folder, or one to continue -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,18,4" Padding="14,14,8,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="2,0,6,10">
                    <TextBlock Text="your Claude Code, here" Style="{StaticResource HandNote}" FontSize="19" />
                    <TextBlock Text="Sessions" Style="{StaticResource Heading}" FontSize="22" Margin="0,2,0,10" />
                    <DockPanel>
                        <Button x:Name="RefreshListButton" DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" Click="RefreshList_Click" />
                        <Button x:Name="NewButton" Content="New session..." Style="{StaticResource PrimaryButton}"
                                Padding="14,0" Click="New_Click" ToolTip="Pick a folder and start a Claude Code session in it" />
                    </DockPanel>
                </StackPanel>
                <ListBox x:Name="SessionList" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SessionList_SelectionChanged"
                         AutomationProperties.Name="Sessions" />
            </DockPanel>
        </Border>

        <!-- the open session -->
        <ContentControl Grid.Column="1" Style="{StaticResource ShadowCard}" Padding="20,16,16,14">
          <Grid>
            <local:SetupPanel x:Name="SetupArea" Visibility="Collapsed" />
            <DockPanel x:Name="ChatArea">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="SetupButton" Content="Setup" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                IsEnabled="False" Click="Setup_Click"
                                ToolTip="Memory, skills, plugins, MCP servers and agents Claude Code has in this folder" />
                        <Button x:Name="CopyResumeButton" Content="Copy resume command" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0" IsEnabled="False" Click="CopyResume_Click"
                                ToolTip="Continue this session in a terminal with the claude CLI" />
                        <Button x:Name="OpenFolderButton" Content="Open folder" Style="{StaticResource SecondaryButton}"
                                IsEnabled="False" Click="OpenFolder_Click" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="SessionTitle" Style="{StaticResource Heading}" FontSize="20" Text="Pick a session" />
                        <TextBlock x:Name="SessionFolder" Style="{StaticResource Eyebrow}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Continue one on the left, or start a new one in a folder. Claude works there with your full setup - memory, skills, plugins, hooks - and full access, like your CLI." />
                    </StackPanel>
                </DockPanel>

                <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                        <Button x:Name="StopButton" Content="Stop" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                IsEnabled="False" Click="Stop_Click" />
                        <Button x:Name="SendButton" Style="{StaticResource PrimaryButton}" IsEnabled="False"
                                AutomationProperties.Name="Send" Click="Send_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Send" VerticalAlignment="Center" />
                                <Path Data="{StaticResource ArrowIcon}" Style="{StaticResource IconPath}" Stroke="White"
                                      StrokeThickness="2.2" Width="16" Height="16" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="WorkingText" Style="{StaticResource HandNote}" FontSize="19" Margin="2,0,0,4"
                                   Visibility="Collapsed" />
                        <TextBox x:Name="InputBox" Style="{StaticResource NotebookBox}" MinHeight="64" MaxHeight="160"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" IsEnabled="False" AutomationProperties.Name="Your message"
                                 PreviewKeyDown="InputBox_PreviewKeyDown" />
                        <TextBlock Text="Enter to send, Shift+Enter for a new line. Claude may edit files and run commands in this folder."
                                   Style="{StaticResource Caption}" FontSize="11.5" Margin="2,6,0,0" />
                    </StackPanel>
                </DockPanel>

                <Grid>
                    <RichTextBox x:Name="Transcript" Style="{StaticResource ReadingBox}" FontSize="14.5" />
                    <StackPanel x:Name="Loading" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <ProgressBar IsIndeterminate="True" Width="220" Margin="0,0,0,10" />
                        <TextBlock Text="Reading the session..." Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </DockPanel>
          </Grid>
        </ContentControl>
    </Grid>
</UserControl>
