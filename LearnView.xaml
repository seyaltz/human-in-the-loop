<UserControl x:Class="DevBreak.LearnView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- one course per topic, as chips -->
        <ListBox x:Name="Tabs" Grid.Row="0" Style="{StaticResource ChipList}" Margin="0,0,0,8"
                 SelectionChanged="Tabs_SelectionChanged" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- the course: a path of lessons, with progress -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,18,4" Padding="16,14,10,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,6,10">
                        <TextBlock Text="foundations to senior" Style="{StaticResource HandNote}" FontSize="20" />
                        <TextBlock x:Name="CourseTitle" Style="{StaticResource Heading}" FontSize="22" Margin="0,2,0,8" />
                        <DockPanel>
                            <TextBlock x:Name="ProgressText" DockPanel.Dock="Right" FontWeight="Bold" FontSize="12.5"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                            <ProgressBar x:Name="ProgressBar" Style="{StaticResource ThinBar}" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                    <ListBox x:Name="LessonList" Style="{StaticResource PathList}" SelectionChanged="LessonList_SelectionChanged" />
                </DockPanel>
            </Border>

            <!-- the lesson -->
            <ContentControl Grid.Column="1" Style="{StaticResource ShadowCard}" Padding="22,18,18,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock x:Name="LessonNumber" Style="{StaticResource Eyebrow}" />
                        <TextBlock x:Name="LessonTitle" Style="{StaticResource Heading}" FontSize="22" Margin="0,2,0,0" />
                        <TextBlock x:Name="LessonSummary" Style="{StaticResource Caption}" FontSize="13.5" Margin="0,4,0,0" />
                    </StackPanel>

                    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
                        <Button x:Name="PreviousButton" DockPanel.Dock="Left" Content="Previous" Style="{StaticResource SecondaryButton}"
                                Click="Previous_Click" />
                        <Button x:Name="NextButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Next lesson"
                                Click="Next_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Next lesson" VerticalAlignment="Center" />
                                <Path Data="{StaticResource ArrowIcon}" Style="{StaticResource IconPath}" Stroke="White"
                                      StrokeThickness="2.2" Width="16" Height="16" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DoneButton" DockPanel.Dock="Right" Style="{StaticResource MarkerButton}" Margin="0,0,12,0"
                                Click="Done_Click" />
                    </DockPanel>

                    <!-- check yourself: a question, and its answer behind an open/close -->
                    <Border x:Name="CheckPanel" DockPanel.Dock="Bottom" Margin="0,12,0,0" CornerRadius="14" Padding="14,12"
                            Background="{StaticResource VioletTintBrush}">
                        <StackPanel>
                            <TextBlock Text="Check yourself" FontWeight="Bold" FontSize="14.5" Margin="0,0,0,4" />
                            <RichTextBox x:Name="CheckQuestionBox" Style="{StaticResource ReadingBox}" MaxHeight="140" FontSize="14" />
                            <Expander x:Name="AnswerExpander" Header="Answer" Style="{StaticResource NoteExpander}" Margin="0,8,0,0">
                                <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="12,10">
                                    <RichTextBox x:Name="AnswerBox" Style="{StaticResource ReadingBox}" MaxHeight="160" FontSize="14" />
                                </Border>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <RichTextBox x:Name="LessonBox" Style="{StaticResource ReadingBox}" FontSize="15" />
                        <StackPanel x:Name="Loading" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="220" Margin="0,0,0,10" />
                            <TextBlock x:Name="LoadingText" HorizontalAlignment="Center" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
