<UserControl x:Class="DevBreak.LearnView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- one course per topic, as chips -->
        <ListBox x:Name="Tabs" Grid.Row="0" Style="{StaticResource ChipList}" Margin="0,0,0,6"
                 SelectionChanged="Tabs_SelectionChanged" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- the course's lessons, with progress -->
            <DockPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock x:Name="ProgressText" DockPanel.Dock="Top" Opacity="0.7" Margin="0,0,0,6" />
                <ListBox x:Name="LessonList" SelectionChanged="LessonList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>

            <!-- the lesson -->
            <DockPanel Grid.Column="1">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock x:Name="LessonTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="LessonSummary" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="PreviousButton" Content="Previous" Margin="0,0,8,0" Padding="14,6" Click="Previous_Click" />
                    <Button x:Name="DoneButton" Content="Mark as done" Margin="0,0,8,0" Padding="14,6" Click="Done_Click" />
                    <Button x:Name="NextButton" Content="Next lesson" Padding="14,6"
                            Style="{DynamicResource AccentButtonStyle}" Click="Next_Click" />
                </StackPanel>

                <!-- check yourself: a question, and its answer behind an open/close -->
                <StackPanel x:Name="CheckPanel" DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBlock Text="Check yourself" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <RichTextBox x:Name="CheckQuestionBox" IsReadOnly="True" IsDocumentEnabled="True" MaxHeight="140"
                                 VerticalScrollBarVisibility="Auto" FontSize="13.5" Padding="10" />
                    <Expander x:Name="AnswerExpander" Header="Answer" Margin="0,8,0,0">
                        <RichTextBox x:Name="AnswerBox" IsReadOnly="True" IsDocumentEnabled="True" MaxHeight="160"
                                     VerticalScrollBarVisibility="Auto" FontSize="13.5" Padding="10" Margin="0,6,0,0" />
                    </Expander>
                </StackPanel>

                <Grid>
                    <RichTextBox x:Name="LessonBox" IsReadOnly="True" IsDocumentEnabled="True"
                                 VerticalScrollBarVisibility="Auto" FontSize="14" Padding="10" />
                    <StackPanel x:Name="Loading" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="220" Margin="0,0,0,10" />
                        <TextBlock x:Name="LoadingText" HorizontalAlignment="Center" Opacity="0.7" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
