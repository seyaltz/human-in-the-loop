<UserControl x:Class="DevBreak.SessionPane"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DevBreak"
        >
    <UserControl.Resources>
        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,6,4" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        </Style>
        <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>
    <!-- the outline marks the active pane when the screen is split -->
    <Border x:Name="Outline" BorderThickness="2.5" CornerRadius="20" BorderBrush="Transparent" Padding="0">
        <ContentControl Style="{StaticResource ShadowCard}" Padding="20,16,16,14">
          <Grid>
            <local:SetupPanel x:Name="SetupArea" Visibility="Collapsed" />
            <Grid x:Name="ChatArea" AllowDrop="True" PreviewDragOver="ChatArea_PreviewDragOver"
                  PreviewDragLeave="ChatArea_PreviewDragLeave" PreviewDrop="ChatArea_PreviewDrop">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <!-- right of the title; under it when the pane is narrow (several panes) -->
                    <StackPanel x:Name="HeaderButtons" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="MoreButton" Content="⋯" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="14,0"
                                IsEnabled="False" Click="More_Click" ToolTip="Rewind, branch, rename, keys and tips"
                                AutomationProperties.Name="More" />
                        <Button x:Name="SetupButton" Content="Setup" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                IsEnabled="False" Click="Setup_Click"
                                ToolTip="Memory, skills, plugins, MCP servers and agents Claude Code has in this folder" />
                        <Button x:Name="CopyResumeButton" Content="Copy resume" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0" IsEnabled="False" Click="CopyResume_Click"
                                ToolTip="Copy the command that continues this session in a terminal" />
                        <Button x:Name="OpenFolderButton" Content="Open folder" Style="{StaticResource SecondaryButton}"
                                IsEnabled="False" Click="OpenFolder_Click" />
                        <Button x:Name="ClosePaneButton" Style="{StaticResource IconButton}" Margin="8,0,0,0" Visibility="Collapsed"
                                ToolTip="Close this pane" AutomationProperties.Name="Close pane" Click="ClosePane_Click">
                            <Path Data="M6,6 L18,18 M18,6 L6,18" Style="{StaticResource IconPath}" Width="14" Height="14" />
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <DockPanel>
                            <!-- green and pulsing while Claude works, red when the last turn failed or was stopped -->
                            <Ellipse x:Name="Light" DockPanel.Dock="Left" Width="11" Height="11" Margin="0,0,9,0" VerticalAlignment="Center"
                                     Visibility="Collapsed" />
                            <TextBlock x:Name="SessionTitle" Style="{StaticResource Heading}" FontSize="20" Text="Pick a session"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock x:Name="SessionFolder" Style="{StaticResource Eyebrow}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Continue one on the left, or start a new one in a folder. Claude works there with your full setup - memory, skills, plugins, hooks - and full access, like your CLI." />
                    </StackPanel>
                </DockPanel>

                <!-- like the CLI's footer: permission mode, model, effort, context, cost, background tasks -->
                <WrapPanel x:Name="StatusBar" DockPanel.Dock="Bottom" Margin="0,6,0,0" Visibility="Collapsed">
                    <Button x:Name="ModeButton" Style="{StaticResource BarButton}" Click="ModeButton_Click"
                            ToolTip="Permission mode - Shift+Tab in the box cycles it" />
                    <Button x:Name="ModelButton" Style="{StaticResource BarButton}" Click="ModelButton_Click" ToolTip="Model (Alt+P)" />
                    <Button x:Name="EffortButton" Style="{StaticResource BarButton}" Click="EffortButton_Click"
                            ToolTip="How hard Claude thinks - applies from the next message" />
                    <Button x:Name="ContextButton" Style="{StaticResource BarButton}" Click="ContextButton_Click" Visibility="Collapsed" />
                    <TextBlock x:Name="CostText" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                               Margin="4,0,8,0" ToolTip="What the turns of this session cost since Dev break started" />
                    <WrapPanel x:Name="TaskChips" VerticalAlignment="Center" />
                    <TextBlock x:Name="WaitChip" FontSize="12" Foreground="{StaticResource VioletDarkBrush}" VerticalAlignment="Center"
                               Margin="4,0,8,0" Visibility="Collapsed"
                               ToolTip="What the turn waits on, for how long, and how long the same command usually takes in your sessions" />
                </WrapPanel>

                <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                        <Button x:Name="StopButton" Content="Stop" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                IsEnabled="False" Click="Stop_Click" />
                        <Button x:Name="SendButton" Style="{StaticResource PrimaryButton}" IsEnabled="False"
                                AutomationProperties.Name="Send" Click="Send_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Send" VerticalAlignment="Center" />
                                <Path Data="{StaticResource ArrowIcon}" Style="{StaticResource IconPath}" Stroke="White"
                                      StrokeThickness="2.2" Width="16" Height="16" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <!-- while a turn runs: how long, how many steps, and the last progress note Claude wrote -->
                        <Border x:Name="LiveBox" Background="{StaticResource VioletTintBrush}" BorderBrush="{StaticResource VioletRingBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="10,6,10,7" Margin="0,0,0,8" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="LiveTitle" FontWeight="Bold" FontSize="13" Foreground="{StaticResource VioletDarkBrush}" />
                                <TextBlock x:Name="LiveNote" FontSize="13" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"
                                           MaxHeight="58" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Visibility="Collapsed" />
                                <TextBlock x:Name="LiveAge" FontSize="11.5" Foreground="{StaticResource InkSoftBrush}" Margin="0,2,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <!-- /btw: an aside answered outside the conversation (side_question), closed with × -->
                        <Border x:Name="AsideBox" Background="{StaticResource PaperBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="10,6,6,8" Margin="0,0,0,8" Visibility="Collapsed">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28"
                                            ToolTip="Close the aside" AutomationProperties.Name="Close aside" Click="CloseAside_Click">
                                        <Path Data="M6,6 L18,18 M18,6 L6,18" Style="{StaticResource IconPath}" Width="10" Height="10" />
                                    </Button>
                                    <TextBlock x:Name="AsideTitle" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource InkSoftBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <FlowDocumentScrollViewer x:Name="AsideText" MaxHeight="200" VerticalScrollBarVisibility="Auto"
                                                          IsToolBarVisible="False" Margin="0,2,0,0" />
                            </DockPanel>
                        </Border>
                        <!-- the coach: a turn going wrong, why, and what to do about it -->
                        <Border x:Name="CoachBox" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CoralInkBrush}"
                                BorderThickness="1.5" CornerRadius="12" Padding="12,8,12,10" Margin="0,0,0,8" Visibility="Collapsed">
                            <StackPanel x:Name="CoachBody" />
                        </Border>
                        <!-- rewind, rename: a small in-pane panel above the box -->
                        <Border x:Name="ActionBox" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource VioletBrush}"
                                BorderThickness="1.5" CornerRadius="12" Padding="12,8,12,10" Margin="0,0,0,8" Visibility="Collapsed">
                            <StackPanel x:Name="ActionBody" />
                        </Border>
                        <TextBlock x:Name="QueuedText" FontSize="12" Foreground="{StaticResource VioletDarkBrush}" Margin="2,0,0,6"
                                   TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                        <TextBlock x:Name="WorkingText" Style="{StaticResource HandNote}" FontSize="19" Margin="2,0,0,4"
                                   Visibility="Collapsed" />
                        <!-- files pasted, dropped or picked, sent with the next message -->
                        <WrapPanel x:Name="Attachments" Margin="0,0,0,2" Visibility="Collapsed" />
                        <!-- "/" at the start of the message: the CLI's commands and skills, narrowed as you type -->
                        <Border x:Name="CommandMenu" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource VioletRingBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="4" Margin="48,0,0,6" Visibility="Collapsed">
                            <DockPanel>
                                <TextBlock x:Name="CommandKeys" DockPanel.Dock="Bottom" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                           Margin="8,4,8,2" TextWrapping="Wrap" />
                                <ScrollViewer x:Name="CommandScroll" MaxHeight="264" VerticalScrollBarVisibility="Auto" Focusable="False">
                                    <StackPanel x:Name="CommandList" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <!-- the picked command's arguments and what it does, while its message is written -->
                        <TextBlock x:Name="CommandHint" FontSize="12" Foreground="{StaticResource InkSoftBrush}" Margin="50,0,0,4"
                                   TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                        <DockPanel>
                            <Button x:Name="AddFilesButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Width="40" Height="40"
                                    Margin="0,0,8,0" VerticalAlignment="Top" IsEnabled="False" Click="AddFiles_Click"
                                    ToolTip="Add files (or paste with Ctrl+V, or drop them here)" AutomationProperties.Name="Add files">
                                <Path Data="M12,5 L12,19 M5,12 L19,12" Style="{StaticResource IconPath}" Width="16" Height="16" />
                            </Button>
                            <TextBox x:Name="InputBox" Style="{StaticResource NotebookBox}" MinHeight="64" MaxHeight="160"
                                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" IsEnabled="False" AutomationProperties.Name="Your message"
                                     PreviewKeyDown="InputBox_PreviewKeyDown" TextChanged="InputBox_TextChanged"
                                     SelectionChanged="InputBox_SelectionChanged" LostKeyboardFocus="InputBox_LostKeyboardFocus" GotKeyboardFocus="InputBox_GotKeyboardFocus" />
                        </DockPanel>
                        <TextBlock Text="Enter to send, Shift+Enter for a new line. / commands and skills, @ files, ! shell, ? keys and tips. Ctrl+V, drop or + to add files. Claude may edit files and run commands in this folder."
                                   Style="{StaticResource Caption}" FontSize="11.5" Margin="2,6,0,0" TextWrapping="Wrap" />

                    </StackPanel>
                </DockPanel>

                <Grid>
                    <RichTextBox x:Name="Transcript" Style="{StaticResource ReadingBox}" FontSize="14.5" />
                    <StackPanel x:Name="Loading" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <ProgressBar IsIndeterminate="True" Width="220" Margin="0,0,0,10" />
                        <TextBlock Text="Reading the session..." Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </DockPanel>
            <!-- "?": every key, and the tips the Claude Code docs give, over the pane -->
            <Border x:Name="SheetOverlay" Visibility="Collapsed" CornerRadius="14" BorderThickness="1.5"
                    BorderBrush="{StaticResource VioletBrush}" Background="{StaticResource CardBrush}" Padding="18,12,10,12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="Close (Esc)"
                                AutomationProperties.Name="Close keys and tips" Click="CloseSheet_Click">
                            <Path Data="M6,6 L18,18 M18,6 L6,18" Style="{StaticResource IconPath}" Width="12" Height="12" />
                        </Button>
                        <TextBlock Text="Keys and tips" Style="{StaticResource Heading}" FontSize="20" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SheetBody" Margin="0,0,8,0" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border x:Name="DropOverlay" IsHitTestVisible="False" Visibility="Collapsed" CornerRadius="14" BorderThickness="2.5"
                    BorderBrush="{StaticResource VioletBrush}" Background="#E6F1EEFF">
                <TextBlock Text="Drop to add the files to your message" Style="{StaticResource Heading}" FontSize="20"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource VioletDarkBrush}" />
            </Border>
            </Grid>
          </Grid>
        </ContentControl>
    </Border>
</UserControl>
