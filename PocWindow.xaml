<Window x:Class="DevBreak.PocWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dev break - proof of concept"
        Width="760" Height="760" MinWidth="480" MinHeight="420"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Grid Margin="20,12,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="OutputRow" Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TopicText" Grid.Row="0" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />

        <RichTextBox x:Name="PocBox" Grid.Row="1" IsReadOnly="True" IsDocumentEnabled="True"
                     VerticalScrollBarVisibility="Auto" FontSize="14" Padding="10" />

        <!-- output of Run, hidden until the first run -->
        <DockPanel x:Name="OutputPanel" Grid.Row="2" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Output" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ProgressBar x:Name="RunningBar" IsIndeterminate="True" Width="80" Margin="10,0,0,0"
                             VerticalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="ExitText" Margin="10,0,0,0" Opacity="0.7" VerticalAlignment="Center" />
            </StackPanel>
            <TextBox x:Name="OutputBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Padding="8"
                     Background="#1E1E1E" Foreground="#D4D4D4" VerticalContentAlignment="Top" />
        </DockPanel>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="RunNote" Opacity="0.6" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="CopiedText" Text="Copied" Opacity="0.7" VerticalAlignment="Center" Margin="10,0,10,0"
                           Visibility="Collapsed" />
                <Button x:Name="CopyButton" Content="Copy code" Padding="14,6" Margin="0,0,8,0" Click="Copy_Click" />
                <Button x:Name="RunButton" Content="Run" Padding="14,6" Margin="0,0,8,0"
                        ToolTipService.ShowOnDisabled="True" Style="{DynamicResource AccentButtonStyle}" Click="Run_Click" />
                <Button Content="Close" Padding="14,6" Click="Close_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
