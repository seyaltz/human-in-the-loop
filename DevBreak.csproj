<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DevBreak</AssemblyName>
    <RootNamespace>DevBreak</RootNamespace>
    <!-- Application.ThemeMode (Fluent theme) is still marked experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- made by Assets\make-icon.ps1 from the same shapes as Assets\logo.svg -->
    <ApplicationIcon>Assets\DevBreak.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- the notebook look's fonts (SIL Open Font License), built into the exe -->
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Assets\DevBreak.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- kept as a plain file next to the exe so it can be edited -->
    <None Update="profile.txt" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
