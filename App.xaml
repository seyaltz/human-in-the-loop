<Application x:Class="DevBreak.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Light"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- the notebook look: grid paper, ink, a violet pen, a highlighter and a coral teacher's pen -->
        <Color x:Key="InkColor">#161A33</Color>
        <Color x:Key="VioletColor">#5B3DF5</Color>
        <SolidColorBrush x:Key="InkBrush" Color="#161A33" />
        <SolidColorBrush x:Key="InkSoftBrush" Color="#4A4F6A" />
        <SolidColorBrush x:Key="VioletBrush" Color="#5B3DF5" />
        <SolidColorBrush x:Key="VioletDarkBrush" Color="#3A22C4" />
        <SolidColorBrush x:Key="VioletTintBrush" Color="#F1EEFF" />
        <SolidColorBrush x:Key="VioletRingBrush" Color="#E4DEFF" />
        <SolidColorBrush x:Key="MarkerBrush" Color="#D4F53C" />
        <SolidColorBrush x:Key="CoralBrush" Color="#FF7A59" />
        <SolidColorBrush x:Key="CoralInkBrush" Color="#D9461F" />
        <SolidColorBrush x:Key="CoralTintBrush" Color="#FFE1D8" />
        <SolidColorBrush x:Key="PaperBrush" Color="#F6F7FB" />
        <SolidColorBrush x:Key="LineBrush" Color="#C9CCE0" />
        <SolidColorBrush x:Key="RuleBrush" Color="#E3E6F3" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8A8FB0" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />

        <!-- the Fluent controls (progress bars, menus, links) take the violet pen as their accent -->
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#5B3DF5" />
        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#6C51F7" />
        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#3A22C4" />
        <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#3A22C4" />
        <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />

        <FontFamily x:Key="BodyFont">pack://application:,,,/Fonts/#DM Sans</FontFamily>
        <FontFamily x:Key="DisplayFont">pack://application:,,,/Fonts/#Bricolage Grotesque</FontFamily>
        <FontFamily x:Key="HandFont">pack://application:,,,/Fonts/#Caveat</FontFamily>
        <FontFamily x:Key="MonoFont">pack://application:,,,/Fonts/#JetBrains Mono, Cascadia Mono, Consolas</FontFamily>

        <!-- grid paper behind every window -->
        <DrawingBrush x:Key="PaperGridBrush" TileMode="Tile" Stretch="None"
                      Viewport="0,0,24,24" ViewportUnits="Absolute" Viewbox="0,0,24,24" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#F6F7FB" Geometry="M0,0 H24 V24 H0 Z" />
                    <GeometryDrawing Brush="#145B3DF5" Geometry="M0,0 H24 V1 H0 Z M0,1 H1 V24 H0 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- the logo: a highlighter speech bubble with a question mark on a violet tile (Assets/logo.svg) -->
        <DrawingImage x:Key="LogoImage">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#5B3DF5">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,100,100" RadiusX="26" RadiusY="26" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#D4F53C"
                                     Geometry="M22,20 h56 a12,12 0 0 1 12,12 v34 a12,12 0 0 1 -12,12 h-30 l-14,12 v-12 h-12 a12,12 0 0 1 -12,-12 v-34 a12,12 0 0 1 12,-12 z" />
                    <GeometryDrawing Geometry="M40,40 a10,10 0 1 1 15,8.7 c-3.2,1.8 -5,3.6 -5,7.3 v2">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#161A33" Thickness="8" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#161A33">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="50,70" RadiusX="4.6" RadiusY="4.6" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- line icons, drawn on a 24x24 grid -->
        <Geometry x:Key="BoltIcon">M13,2 L4,14 H11 L10,22 L20,9 H13 Z</Geometry>
        <Geometry x:Key="FlameIcon">M12,2 C13,7 18,9 18,15 A6,6 0 0 1 6,15 C6,11 9,10 9,6 C10.5,7.5 11,9 11,10 C12.5,8.5 12.5,5 12,2 Z</Geometry>
        <Geometry x:Key="TargetIcon">M12,3.5 A8.5,8.5 0 1 1 11.99,3.5 M12,7.5 A4.5,4.5 0 1 1 11.99,7.5 M12,11 A1,1 0 1 1 11.99,11</Geometry>
        <Geometry x:Key="SettingsIcon">M4,7 H13 M17,7 H20 M15,4.5 V9.5 M4,17 H7 M11,17 H20 M9,14.5 V19.5</Geometry>
        <Geometry x:Key="CheckIcon">M5,12.5 L10,17 L19,7</Geometry>
        <Geometry x:Key="ArrowIcon">M5,12 H19 M13,6 L19,12 L13,18</Geometry>
        <Geometry x:Key="BookIcon">M4,5 C7,4 10,4.5 12,6 C14,4.5 17,4 20,5 V19 C17,18 14,18.5 12,20 C10,18.5 7,18 4,19 Z M12,6 V20</Geometry>
        <Geometry x:Key="ChevronIcon">M6,9 L12,15 L18,9</Geometry>
        <Geometry x:Key="SparkleIcon">M12,3 L13.8,9.2 L20,11 L13.8,12.8 L12,19 L10.2,12.8 L4,11 L10.2,9.2 Z</Geometry>
        <Geometry x:Key="ChatIcon">M5,5 H19 A2,2 0 0 1 21,7 V15 A2,2 0 0 1 19,17 H11 L6,21 V17 H5 A2,2 0 0 1 3,15 V7 A2,2 0 0 1 5,5 Z</Geometry>

        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- handwritten margin notes -->
        <Style x:Key="HandNote" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource HandFont}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource VioletBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="RenderTransformOrigin" Value="0,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="-2" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- buttons: chunky ink outlines, the main one with a hard offset shadow -->
        <ControlTemplate x:Key="ChunkyButtonTemplate" TargetType="Button">
            <Grid>
                <Border x:Name="Shadow" CornerRadius="12" Background="{StaticResource InkBrush}" Margin="3,3,-3,-3" />
                <Border x:Name="Face" CornerRadius="12" Background="{TemplateBinding Background}"
                        BorderBrush="{StaticResource InkBrush}" BorderThickness="1.5" Padding="{TemplateBinding Padding}">

                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Face" Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform X="2" Y="2" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Shadow" Property="Visibility" Value="Hidden" />
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="FlatButtonTemplate" TargetType="Button">
            <Border x:Name="Face" CornerRadius="12" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource VioletBrush}" />
            <Setter Property="Template" Value="{StaticResource ChunkyButtonTemplate}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource VioletDarkBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource VioletTintBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MarkerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="{StaticResource MarkerBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C3E52B" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Quiz / Learn / Stats: a pill switch -->
        <Style x:Key="ModeTab" TargetType="RadioButton">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border CornerRadius="18" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource VioletTintBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource InkBrush}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- the XP / streak / goal chips in the top bar -->
        <Style x:Key="HudChip" TargetType="Border">
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- topics as rounded chips that wrap; the picked one is highlighted with the marker -->
        <Style x:Key="ChipList" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,8,8" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FontSize" Value="13.5" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Chip" CornerRadius="17" Height="34" Padding="14,0" BorderThickness="1.5"
                                            BorderBrush="{StaticResource LineBrush}" Background="{StaticResource CardBrush}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource InkSoftBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource MarkerBrush}" />
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource InkBrush}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a flat white card -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
        </Style>

        <!-- the main card: ink outline and a hard offset shadow, like a sticker on the page -->
        <Style x:Key="ShadowCard" TargetType="ContentControl">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid Margin="0,0,4,4">
                            <Border CornerRadius="18" Background="{StaticResource InkBrush}" Margin="4,4,-4,-4" />
                            <Border CornerRadius="18" Background="{TemplateBinding Background}" BorderBrush="{StaticResource InkBrush}"
                                    BorderThickness="1.5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- text you type: a white box with an ink outline that turns violet while you write -->
        <Style x:Key="NotebookBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource VioletBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource VioletBrush}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Box" CornerRadius="14" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource VioletBrush}" />
                                <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- text you read: no box of its own, it sits in a card -->
        <Style x:Key="ReadingBox" TargetType="RichTextBox">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource VioletBrush}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsDocumentEnabled" Value="True" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RichTextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- open/close sections (the hint, the answer): a dashed violet strip with a book icon -->
        <Style x:Key="NoteExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource VioletDarkBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Top" Cursor="Hand" Focusable="True" HorizontalAlignment="Left"
                                          Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid MinHeight="42">
                                            <Rectangle x:Name="Strip" RadiusX="10" RadiusY="10" Fill="{StaticResource VioletTintBrush}"
                                                       Stroke="{StaticResource VioletBrush}" StrokeThickness="1.5" StrokeDashArray="3 2" />
                                            <DockPanel Margin="14,0" VerticalAlignment="Center">
                                                <Path DockPanel.Dock="Left" Data="{StaticResource BookIcon}" Style="{StaticResource IconPath}"
                                                      Stroke="{StaticResource VioletDarkBrush}" StrokeThickness="1.8" Margin="0,0,10,0" />
                                                <Path x:Name="Chevron" DockPanel.Dock="Right" Data="{StaticResource ChevronIcon}"
                                                      Style="{StaticResource IconPath}" Stroke="{StaticResource VioletDarkBrush}"
                                                      Width="14" Height="14" Margin="12,0,0,0" RenderTransformOrigin="0.5,0.5" />
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Strip" Property="Fill" Value="{StaticResource VioletRingBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Visibility="Collapsed" TextElement.FontWeight="Normal"
                                              TextElement.Foreground="{StaticResource InkBrush}" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a topic to tick: a card with a tick box; ticked ones get the violet outline and the marker -->
        <Style x:Key="TopicCard" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Shadow" CornerRadius="16" Background="{StaticResource VioletBrush}"
                                    Margin="3,3,-3,-3" Visibility="Hidden" />
                            <Border x:Name="Card" CornerRadius="16" Background="{StaticResource CardBrush}" MinHeight="72"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="2" Padding="14,12">
                                <DockPanel>
                                    <Border x:Name="Box" DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="8"
                                            VerticalAlignment="Top" Margin="0,1,14,0" BorderThickness="2"
                                            BorderBrush="{StaticResource MutedBrush}" Background="{StaticResource CardBrush}">
                                        <Path x:Name="Tick" Data="{StaticResource CheckIcon}" Style="{StaticResource IconPath}"
                                              Stroke="{StaticResource InkBrush}" StrokeThickness="3" Width="14" Height="14"
                                              Visibility="Hidden" />
                                    </Border>
                                    <ContentPresenter VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource InkSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource VioletBrush}" />
                                <Setter TargetName="Shadow" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource MarkerBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource InkBrush}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource InkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- the lessons of a course, drawn as a path of stops -->
        <Style x:Key="PathList" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" CornerRadius="12" Padding="8,0" Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="#F8F7FF" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource VioletTintBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="10" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource VioletBrush}" />
            <Setter Property="Background" Value="#EEF0F8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="5" Background="{TemplateBinding Background}" />
                            <Border x:Name="PART_Indicator" CornerRadius="5" Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
