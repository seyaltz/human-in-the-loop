<UserControl x:Class="DevBreak.FactoryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="370" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- a new task, and the runs -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,4" Padding="16,14,10,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,6,8">
                    <TextBlock Text="from task to draft PR" Style="{StaticResource HandNote}" FontSize="19" />
                    <TextBlock Text="Factory" Style="{StaticResource Heading}" FontSize="22" Margin="0,2,0,10" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="TypedSource" Content="Typed" GroupName="Source" Style="{StaticResource PillRadio}"
                                     IsChecked="True" Checked="Source_Checked" />
                        <RadioButton x:Name="JiraSource" Content="Jira" GroupName="Source" Style="{StaticResource PillRadio}"
                                     Margin="6,0,0,0" Checked="Source_Checked" />
                        <RadioButton x:Name="SpecSource" Content="Spec doc" GroupName="Source" Style="{StaticResource PillRadio}"
                                     Margin="6,0,0,0" Checked="Source_Checked" />
                    </StackPanel>
                    <DockPanel Margin="2,0,0,4">
                        <Button x:Name="BrowseSpecButton" DockPanel.Dock="Right" Content="Browse..." Style="{StaticResource SecondaryButton}"
                                Height="30" Padding="10,0" Visibility="Collapsed" Click="BrowseSpec_Click" />
                        <TextBlock x:Name="TaskLabel" Text="What to build or fix" Style="{StaticResource Caption}" VerticalAlignment="Bottom" />
                    </DockPanel>
                    <TextBox x:Name="TaskBox" Style="{StaticResource NotebookBox}" Height="92" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="Task" />

                    <TextBlock Text="Repository" Style="{StaticResource Caption}" Margin="2,10,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse..." Style="{StaticResource SecondaryButton}" Height="40"
                                Padding="10,0" Margin="6,0,0,0" Click="BrowseRepo_Click" />
                        <ComboBox x:Name="RepoBox" IsEditable="True" Height="40" VerticalContentAlignment="Center" FontSize="13"
                                  AutomationProperties.Name="Repository" SelectionChanged="RepoBox_SelectionChanged"
                                  LostKeyboardFocus="RepoBox_LostFocus" />
                    </DockPanel>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Base branch" Style="{StaticResource Caption}" Margin="2,0,0,4" />
                            <TextBox x:Name="BaseBox" Style="{StaticResource NotebookBox}" FontSize="13" AutomationProperties.Name="Base branch" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Verify command (empty: Claude proposes one)" Style="{StaticResource Caption}" Margin="2,0,0,4"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBox x:Name="VerifyBox" Style="{StaticResource NotebookBox}" FontFamily="{StaticResource MonoFont}"
                                     FontSize="12.5" AutomationProperties.Name="Verify command" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="FormError" Foreground="{StaticResource CoralInkBrush}" TextWrapping="Wrap" Margin="2,8,0,0"
                               Visibility="Collapsed" />
                    <Button x:Name="StartButton" Content="Start run" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                            Click="Start_Click"
                            ToolTip="Plan, build, verify, review, then a draft PR - in its own worktree and branch" />
                    <TextBlock Text="Runs" Style="{StaticResource Eyebrow}" Margin="2,16,0,0" />
                </StackPanel>
                <ListBox x:Name="RunList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="RunList_SelectionChanged" AutomationProperties.Name="Runs" />
            </DockPanel>
        </Border>

        <!-- the selected run -->
        <ContentControl Grid.Column="1" Style="{StaticResource ShadowCard}" Padding="20,16,16,14">
            <Grid>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Caption}" TextWrapping="Wrap" FontSize="14" Margin="4"
                           Text="Give the factory a task - typed, a Jira issue or a spec - and a repository. Each run works in its own git worktree and branch: Claude plans, builds and fixes until the verify command passes, a read-only reviewer checks the diff, and then Claude opens a draft PR. What the run learned goes into the repo's Claude memory; new rules (CLAUDE.md, hooks, skills) wait for your OK." />
                <DockPanel x:Name="RunArea" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" MaxWidth="420"
                                   HorizontalAlignment="Right">
                            <Button x:Name="StopButton" Content="Stop" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Click="Stop_Click" />
                            <Button x:Name="AnywayButton" Content="Draft PR anyway" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"
                                    Click="Anyway_Click" ToolTip="Open the draft PR even though a check failed - its description says what failed" />
                            <Button x:Name="OpenPrButton" Content="Open PR" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" Click="OpenPr_Click" />
                            <Button x:Name="SessionButton" Content="Open in Sessions" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"
                                    Click="Session_Click" ToolTip="Continue this run's Claude Code session yourself" />
                            <Button x:Name="FolderButton" Content="Open worktree" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6"
                                    Click="Folder_Click" />
                        </WrapPanel>
                        <StackPanel>
                            <DockPanel>
                                <Ellipse x:Name="Light" DockPanel.Dock="Left" Width="11" Height="11" Margin="0,0,9,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="RunTitle" Style="{StaticResource Heading}" FontSize="20" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock x:Name="RunMeta" Style="{StaticResource Eyebrow}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <!-- one line: where the run is, or why it stopped (the whole reason is in the log) -->
                            <TextBlock x:Name="RunNote" FontSize="13.5" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="40"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                    <!-- the pipeline: each stage done, now, or to come -->
                    <WrapPanel x:Name="Pipeline" DockPanel.Dock="Top" Margin="0,0,0,10" />
                    <!-- what it learned -->
                    <StackPanel x:Name="LessonsArea" DockPanel.Dock="Bottom" Margin="0,10,0,0" Visibility="Collapsed">
                        <TextBlock Text="Learned for this repo's Claude" Style="{StaticResource Eyebrow}" Margin="2,0,0,6" />
                        <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="LessonList" />
                        </ScrollViewer>
                    </StackPanel>
                    <RichTextBox x:Name="LogBox" Style="{StaticResource ReadingBox}" FontSize="13.5" AutomationProperties.Name="Run log" />
                </DockPanel>
            </Grid>
        </ContentControl>
    </Grid>
</UserControl>
