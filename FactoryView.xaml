<UserControl x:Class="DevBreak.FactoryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="370" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- a new task, and the runs -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,4" Padding="16,14,10,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,6,8">
                    <TextBlock Text="from task to draft PR" Style="{StaticResource HandNote}" FontSize="19" />
                    <TextBlock Text="Factory" Style="{StaticResource Heading}" FontSize="22" Margin="0,2,0,10" />
                    <!-- a new task, or the runs so far -->
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="NewTab" Content="New task" GroupName="LeftTab" Style="{StaticResource PillRadio}" IsChecked="True"
                                     Checked="LeftTab_Checked" />
                        <RadioButton x:Name="RunsTab" Content="History" GroupName="LeftTab" Style="{StaticResource PillRadio}" Margin="6,0,0,0"
                                     Checked="LeftTab_Checked" />
                    </StackPanel>
                </StackPanel>
                <Grid>
                <ScrollViewer x:Name="FormArea" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="TypedSource" Content="Typed" GroupName="Source" Style="{StaticResource PillRadio}"
                                     IsChecked="True" Checked="Source_Checked" />
                        <RadioButton x:Name="JiraSource" Content="Jira" GroupName="Source" Style="{StaticResource PillRadio}"
                                     Margin="6,0,0,0" Checked="Source_Checked" />
                        <RadioButton x:Name="SpecSource" Content="Spec doc" GroupName="Source" Style="{StaticResource PillRadio}"
                                     Margin="6,0,0,0" Checked="Source_Checked" />
                    </StackPanel>
                    <DockPanel Margin="2,0,0,4">
                        <Button x:Name="BrowseSpecButton" DockPanel.Dock="Right" Content="Browse..." Style="{StaticResource SecondaryButton}"
                                Height="30" Padding="10,0" Visibility="Collapsed" Click="BrowseSpec_Click" />
                        <TextBlock x:Name="TaskLabel" Text="What to build or fix" Style="{StaticResource Caption}" VerticalAlignment="Bottom" />
                    </DockPanel>
                    <TextBox x:Name="TaskBox" Style="{StaticResource NotebookBox}" Height="92" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="Task" />

                    <TextBlock Text="Folder - the repo, or where your repos are (Claude finds the one for the task)" Style="{StaticResource Caption}"
                               Margin="2,10,0,4" TextWrapping="Wrap" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse..." Style="{StaticResource SecondaryButton}" Height="40"
                                Padding="10,0" Margin="6,0,0,0" Click="BrowseRepo_Click" />
                        <ComboBox x:Name="RepoBox" IsEditable="True" Height="40" VerticalContentAlignment="Center" FontSize="13"
                                  AutomationProperties.Name="Folder" SelectionChanged="RepoBox_SelectionChanged"
                                  LostKeyboardFocus="RepoBox_LostFocus" />
                    </DockPanel>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Base branch" Style="{StaticResource Caption}" Margin="2,0,0,4"
                                       ToolTip="Empty: the branch the repo has checked out" />
                            <TextBox x:Name="BaseBox" Style="{StaticResource NotebookBox}" FontSize="13" AutomationProperties.Name="Base branch" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Verify command (empty: Claude proposes one)" Style="{StaticResource Caption}" Margin="2,0,0,4"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBox x:Name="VerifyBox" Style="{StaticResource NotebookBox}" FontFamily="{StaticResource MonoFont}"
                                     FontSize="12.5" AutomationProperties.Name="Verify command" />
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="AutonomousBox" Margin="2,10,0,0" IsChecked="True" AutomationProperties.Name="Autonomous"
                              ToolTip="No human in the loop: the plan's questions take the suggested answers, the run fixes what it needs outside the repo (backed up and listed), learned rules apply at once, and it stops only for what no tool can do - a login">
                        <TextBlock TextWrapping="Wrap" FontSize="13"><Run FontWeight="SemiBold" Text="Autonomous" /><Run Text=" - no stops; it decides, fixes and learns on its own" /></TextBlock>
                    </CheckBox>
                    <CheckBox x:Name="ReportBox" Margin="2,6,0,0" AutomationProperties.Name="Designed report"
                              ToolTip="When the run is done, Claude turns its result into one readable HTML page - summary first, sections, tables, diagrams, decisions, what is not verified, the evidence">
                        <TextBlock TextWrapping="Wrap" FontSize="13"><Run FontWeight="SemiBold" Text="Designed report" /><Run Text=" - a readable page of the result when it is done" /></TextBlock>
                    </CheckBox>
                    <TextBlock x:Name="FormError" Foreground="{StaticResource CoralInkBrush}" TextWrapping="Wrap" Margin="2,8,0,0"
                               Visibility="Collapsed" />
                    <Button x:Name="StartButton" Content="Start run" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                            Click="Start_Click"
                            ToolTip="Plan, build, verify, review, then a draft PR - in its own worktree and branch" />
                </StackPanel>
                </ScrollViewer>
                <DockPanel x:Name="RunsArea" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Margin="2,0,6,6">
                        <Button x:Name="CleanAllButton" DockPanel.Dock="Right" Content="Clean up all" Style="{StaticResource SecondaryButton}"
                                Height="32" Padding="12,0" Click="CleanAll_Click"
                                ToolTip="Delete the worktrees, evidence and session files of every run that is not working - the records stay" />
                        <TextBlock x:Name="RunsSummary" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <ListBox x:Name="RunList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="RunList_SelectionChanged" AutomationProperties.Name="Runs" />
                </DockPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- the selected run -->
        <ContentControl Grid.Column="1" Style="{StaticResource ShadowCard}" Padding="20,16,16,14">
            <Grid>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Caption}" TextWrapping="Wrap" FontSize="14" Margin="4"
                           Text="Give the factory a task - typed, a Jira issue or a spec - and a repository. Each run works in your checkout on a new branch: Claude plans, builds and fixes until the verify command passes, proves it in the running app, a read-only reviewer checks the diff, and then Claude opens a draft PR. Facts it learned go into the repo's Claude memory; rules, skills and hooks are kept by the factory outside the repo, for its next runs there." />
                <DockPanel x:Name="RunArea" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" MaxWidth="420"
                                   HorizontalAlignment="Right">
                            <Button x:Name="StopButton" Content="Stop" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Click="Stop_Click" />
                            <Button x:Name="ContinueButton" Content="Continue" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" Click="Continue_Click"
                                    ToolTip="Pick up where the run stopped: finish what is missing, then verify, prove, review and the draft PR" />
                            <Button x:Name="WorktreeButton" Content="Use a separate worktree" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"
                                    Click="Worktree_Click" ToolTip="Leave your checkout as it is: this run goes on in its own worktree beside the repo" />
                            <Button x:Name="CleanButton" Content="Clean up" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6" Click="Clean_Click"
                                    ToolTip="Delete this run's worktree, evidence and session files - the record stays" />
                            <Button x:Name="AnywayButton" Content="Draft PR anyway" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"
                                    Click="Anyway_Click" ToolTip="Open the draft PR even though a check failed - its description says what failed" />
                            <Button x:Name="OpenPrButton" Content="Open PR" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6" Click="OpenPr_Click" />
                            <Button x:Name="SessionButton" Content="Open in Sessions" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"
                                    Click="Session_Click" ToolTip="Continue this run's Claude Code session yourself" />
                            <Button x:Name="ReportButton" Content="Open report" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6"
                                    Click="Report_Click" ToolTip="The designed report of this run, in your browser" />
                            <Button x:Name="ProofButton" Content="Open evidence" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"
                                    Click="Proof_Click" ToolTip="Screenshots, responses and logs from running the app with the change" />
                            <Button x:Name="FolderButton" Content="Open folder" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6"
                                    Click="Folder_Click" />
                        </WrapPanel>
                        <StackPanel>
                            <DockPanel>
                                <Ellipse x:Name="Light" DockPanel.Dock="Left" Width="11" Height="11" Margin="0,0,9,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="RunTitle" Style="{StaticResource Heading}" FontSize="20" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock x:Name="RunMeta" Style="{StaticResource Eyebrow}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <!-- one line: where the run is, or why it stopped (the whole reason is in the log) -->
                            <TextBlock x:Name="RunNote" FontSize="13.5" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="40"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                    <!-- what the task asked to be handed back (a curl, an answer, a link), ready to use -->
                    <Border x:Name="ResultBox" DockPanel.Dock="Top" Visibility="Collapsed" Background="{StaticResource MarkerBrush}"
                            BorderBrush="{StaticResource InkBrush}" BorderThickness="1.5" CornerRadius="12" Padding="12,8" Margin="0,0,0,10">
                        <DockPanel>
                            <Button x:Name="CopyResultButton" DockPanel.Dock="Right" Content="Copy" Style="{StaticResource SecondaryButton}"
                                    Height="32" Padding="12,0" Margin="8,0,0,0" VerticalAlignment="Top" Click="CopyResult_Click" />
                            <StackPanel>
                                <TextBlock Text="Result" FontWeight="Bold" FontSize="13" Margin="0,0,0,4" />
                                <TextBox x:Name="ResultText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                         FontFamily="{StaticResource MonoFont}" FontSize="12.5" MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Result" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- what a clean up would delete, before it does -->
                    <Border x:Name="ConfirmBar" DockPanel.Dock="Top" Visibility="Collapsed" BorderBrush="{StaticResource CoralInkBrush}"
                            BorderThickness="1.5" CornerRadius="12" Padding="12,8" Margin="0,0,0,10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ConfirmButton" Content="Delete it" Style="{StaticResource PrimaryButton}" Height="34" Padding="14,0"
                                        Margin="8,0,8,0" Click="Confirm_Click" />
                                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0" Click="CancelConfirm_Click" />
                            </StackPanel>
                            <TextBlock x:Name="ConfirmText" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <!-- the pipeline: each stage done, now, or to come -->
                    <WrapPanel x:Name="Pipeline" DockPanel.Dock="Top" Margin="0,0,0,10" />
                    <!-- your feedback: rate the run, or send it what to change -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1.5,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="RateButton" DockPanel.Dock="Right" Content="Save rating" Style="{StaticResource SecondaryButton}"
                                        Height="36" Padding="12,0" Margin="8,0,0,0" Click="Rate_Click"
                                        ToolTip="Saves your verdict; the run learns again from what you said" />
                                <RadioButton x:Name="GoodRating" DockPanel.Dock="Left" Content="👍 Good" GroupName="Rating" Style="{StaticResource PillRadio}" />
                                <RadioButton x:Name="BadRating" DockPanel.Dock="Left" Content="👎 Bad" GroupName="Rating" Style="{StaticResource PillRadio}" Margin="6,0,8,0" />
                                <TextBox x:Name="RatingNote" Style="{StaticResource NotebookBox}" FontSize="13" MinHeight="36" Padding="10,6"
                                         AutomationProperties.Name="Rating note" ToolTip="What was good or bad about this run" />
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0">
                                <Button x:Name="FeedbackButton" DockPanel.Dock="Right" Content="Send to the run" Style="{StaticResource PrimaryButton}"
                                        Height="40" Padding="14,0" Margin="8,0,0,0" VerticalAlignment="Top" Click="Feedback_Click"
                                        ToolTip="Claude applies it, verify and review run again, and the draft PR updates" />
                                <TextBox x:Name="FeedbackBox" Style="{StaticResource NotebookBox}" FontSize="13" MinHeight="40" MaxHeight="90" Padding="10,7"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Feedback to the run" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <!-- what happened: the log, the trace (each step with its tools, prompt and answer), what it learned -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="LogTab" Content="Log" GroupName="RunTab" Style="{StaticResource PillRadio}" IsChecked="True" Checked="RunTab_Checked" />
                        <RadioButton x:Name="TraceTab" Content="Trace" GroupName="RunTab" Style="{StaticResource PillRadio}" Margin="6,0,0,0" Checked="RunTab_Checked" />
                        <RadioButton x:Name="EvidenceTab" Content="Evidence" GroupName="RunTab" Style="{StaticResource PillRadio}" Margin="6,0,0,0" Checked="RunTab_Checked" />
                        <RadioButton x:Name="LessonsTab" Content="Learned" GroupName="RunTab" Style="{StaticResource PillRadio}" Margin="6,0,0,0" Checked="RunTab_Checked" />
                        <Button x:Name="ExportButton" Content="Export trace" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,0"
                                Margin="12,0,0,0" Click="Export_Click" ToolTip="Saves the whole run as .json and .md in the traces folder next to Dev break" />
                        <TextBlock x:Name="ExportText" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Visibility="Collapsed">
                            <Hyperlink x:Name="ExportLink" Click="ExportLink_Click"><Run x:Name="ExportRun" /></Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    <Grid>
                        <RichTextBox x:Name="LogBox" Style="{StaticResource ReadingBox}" FontSize="13.5" AutomationProperties.Name="Run log" />
                        <ScrollViewer x:Name="TraceArea" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel x:Name="TraceList" Margin="0,0,8,0" />
                        </ScrollViewer>
                        <ScrollViewer x:Name="EvidenceArea" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel x:Name="EvidenceList" Margin="0,0,8,0" />
                        </ScrollViewer>
                        <ScrollViewer x:Name="LessonsArea" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel x:Name="LessonList" Margin="0,0,8,0" />
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Grid>
        </ContentControl>
    </Grid>
</UserControl>
