<Window x:Class="DevBreak.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dev break - discuss"
        Width="760" Height="760" MinWidth="480" MinHeight="420"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Grid Margin="20,12,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TopicText" Grid.Row="0" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />

        <RichTextBox x:Name="Transcript" Grid.Row="1" IsReadOnly="True" IsDocumentEnabled="True"
                     VerticalScrollBarVisibility="Auto" FontSize="14" Padding="10" />

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button x:Name="SendButton" DockPanel.Dock="Right" Content="Send" Padding="18,6" Margin="8,0,0,0"
                    VerticalAlignment="Bottom" Style="{DynamicResource AccentButtonStyle}" Click="Send_Click" />
            <StackPanel>
                <TextBlock x:Name="ThinkingText" Text="Claude is thinking..." Opacity="0.7" Margin="0,0,0,4"
                           Visibility="Collapsed" />
                <TextBox x:Name="InputBox" MinHeight="60" MaxHeight="140" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         PreviewKeyDown="InputBox_PreviewKeyDown" />
                <TextBlock Text="Enter to send, Shift+Enter for a new line" Opacity="0.5" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
