<Window x:Class="DevBreak.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dev break - discuss"
        Icon="pack://application:,,,/Assets/DevBreak.ico"
        Width="760" Height="760" MinWidth="480" MinHeight="420"
        Background="{StaticResource PaperGridBrush}"
        FontFamily="{StaticResource BodyFont}" FontSize="14" Foreground="{StaticResource InkBrush}"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Image Source="{StaticResource LogoImage}" Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="let's talk it through" Style="{StaticResource HandNote}" FontSize="19" />
                <TextBlock x:Name="TopicText" Style="{StaticResource Heading}" FontSize="20" />
            </StackPanel>
        </StackPanel>

        <ContentControl Grid.Row="1" Style="{StaticResource ShadowCard}" Padding="18,14">
            <RichTextBox x:Name="Transcript" Style="{StaticResource ReadingBox}" />
        </ContentControl>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"
                    VerticalAlignment="Top" AutomationProperties.Name="Send" Click="Send_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Send" VerticalAlignment="Center" />
                    <Path Data="{StaticResource ArrowIcon}" Style="{StaticResource IconPath}" Stroke="White" StrokeThickness="2.2"
                          Width="16" Height="16" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock x:Name="ThinkingText" Text="Claude is thinking..." Style="{StaticResource HandNote}" FontSize="19"
                           Margin="2,0,0,4" Visibility="Collapsed" />
                <TextBox x:Name="InputBox" Style="{StaticResource NotebookBox}" MinHeight="64" MaxHeight="140" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         AutomationProperties.Name="Your message" PreviewKeyDown="InputBox_PreviewKeyDown" />
                <TextBlock Text="Enter to send, Shift+Enter for a new line" Style="{StaticResource Caption}" FontSize="11.5"
                           Margin="2,6,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
