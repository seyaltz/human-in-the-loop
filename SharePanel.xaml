<UserControl x:Class="DevBreak.SharePanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" VerticalAlignment="Top"
                    ToolTip="Close" AutomationProperties.Name="Close save panel" Click="Close_Click">
                <Path Data="M6,6 L18,18 M18,6 L6,18" Style="{StaticResource IconPath}" Width="14" Height="14" />
            </Button>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="save it to your Claude" Style="{StaticResource HandNote}" FontSize="19" />
                <TextBlock x:Name="ItemText" Style="{StaticResource Heading}" FontSize="17" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <ContentControl Grid.Row="1" Style="{StaticResource ShadowCard}" Padding="14,12">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Suggestions" />
                </ScrollViewer>
                <StackPanel x:Name="Loading" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Margin="0,0,0,10" />
                    <TextBlock Text="Claude is matching it to your projects..." Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </ContentControl>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Save selected" Style="{StaticResource PrimaryButton}"
                    IsEnabled="False" Click="Save_Click" />
            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="2,0,12,0"
                       Text="Nothing is saved until you press Save." />
        </DockPanel>
    </Grid>
</UserControl>
