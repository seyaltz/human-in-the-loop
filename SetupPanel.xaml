<UserControl x:Class="DevBreak.SetupPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        >
    <DockPanel>
        <!-- what Claude Code is, here -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBox x:Name="FilterBox" Width="190" Style="{StaticResource NotebookBox}" Margin="0,0,8,0"
                         VerticalContentAlignment="Center" AutomationProperties.Name="Filter" ToolTip="Filter by name or description"
                         TextChanged="Filter_TextChanged" />
                <Button x:Name="RefreshButton" Content="Refresh" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Click="Refresh_Click" />
                <Button x:Name="BackButton" Content="Back to chat" Style="{StaticResource PrimaryButton}" Padding="16,0"
                        Click="Back_Click" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="what Claude Code has here" Style="{StaticResource HandNote}" FontSize="19" />
                <TextBlock x:Name="Facts" Style="{StaticResource Eyebrow}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- the parts, as sub-tabs, and a filter -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,10" HorizontalAlignment="Left" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource InkBrush}" BorderThickness="1.5" CornerRadius="22" Padding="4">
            <StackPanel x:Name="Parts" Orientation="Horizontal" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="ItemList" Grid.Column="0" Margin="0,0,14,0" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ItemList_SelectionChanged"
                     AutomationProperties.Name="Setup items" />
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock x:Name="DetailTitle" Style="{StaticResource Heading}" FontSize="17" />
                        <TextBlock x:Name="DetailMeta" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="UseButton" Content="Use in this session" Style="{StaticResource PrimaryButton}" Padding="14,0"
                                    Margin="0,0,8,0" Visibility="Collapsed" Click="Use_Click" />
                            <Button x:Name="OpenFileButton" Content="Open file" Style="{StaticResource SecondaryButton}"
                                    Visibility="Collapsed" Click="OpenFile_Click" />
                        </StackPanel>
                    </StackPanel>
                    <Grid>
                        <RichTextBox x:Name="DetailBox" Style="{StaticResource ReadingBox}" FontSize="13.5" />
                        <StackPanel x:Name="Loading" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <ProgressBar IsIndeterminate="True" Width="200" Margin="0,0,0,10" />
                            <TextBlock Text="Asking Claude Code what it has in this folder..." Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
