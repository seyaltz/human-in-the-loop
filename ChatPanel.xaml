<UserControl x:Class="DevBreak.ChatPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" VerticalAlignment="Top"
                    ToolTip="Close the discussion" AutomationProperties.Name="Close discussion" Click="Close_Click">
                <Path Data="M6,6 L18,18 M18,6 L6,18" Style="{StaticResource IconPath}" Width="14" Height="14" />
            </Button>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="let's talk it through" Style="{StaticResource HandNote}" FontSize="19" />
                <TextBlock x:Name="TopicText" Style="{StaticResource Heading}" FontSize="19" />
            </StackPanel>
        </DockPanel>

        <ContentControl Grid.Row="1" Style="{StaticResource ShadowCard}" Padding="16,12">
            <RichTextBox x:Name="Transcript" Style="{StaticResource ReadingBox}" FontSize="14.5" />
        </ContentControl>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                    Padding="18,0" VerticalAlignment="Top" AutomationProperties.Name="Send" Click="Send_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Send" VerticalAlignment="Center" />
                    <Path Data="{StaticResource ArrowIcon}" Style="{StaticResource IconPath}" Stroke="White" StrokeThickness="2.2"
                          Width="16" Height="16" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock x:Name="ThinkingText" Text="Claude is thinking..." Style="{StaticResource HandNote}" FontSize="19"
                           Margin="2,0,0,4" Visibility="Collapsed" />
                <TextBox x:Name="InputBox" Style="{StaticResource NotebookBox}" MinHeight="64" MaxHeight="140" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         AutomationProperties.Name="Your message" PreviewKeyDown="InputBox_PreviewKeyDown" />
                <TextBlock Text="Enter to send, Shift+Enter for a new line" Style="{StaticResource Caption}" FontSize="11.5"
                           Margin="2,6,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
